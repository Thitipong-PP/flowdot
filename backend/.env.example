PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGIN=*
MONGODB_URI=mongodb://127.0.0.1:27017/flowdot
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=replace-with-the-same-random-secret-configured-in-AI-env
AI_SERVICE_TIMEOUT_MS=180000
NODE_ENV=development
