# ==============================================================================
# SME Financial Copilot - Environment Configuration Template
# ==============================================================================

# Typhoon OCR API Key (กรอก Key ของคุณที่นี่)
TYPHOON_API_KEY=your_typhoon_api_key_here
TYPHOON_OCR_API_URL=https://api.opentyphoon.ai/v1

# MongoDB Connection
# สำหรับ Local: mongodb://localhost:27017
# สำหรับ MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=fintech_copilot

# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MAIN_MODEL=qwen3:4b
OLLAMA_WORKER_MODEL=qwen3:1.7b

# System Settings
DEBUG=True
DEBOUNCE_WAIT_SECONDS=3.0
FAST_PATH_LATENCY_THRESHOLD_MS=200.0
