# ==============================================================================
# SME Financial Copilot - Environment Configuration Template
# ==============================================================================

# Typhoon OCR API key (optional)
TYPHOON_API_KEY=your_typhoon_api_key_here
TYPHOON_OCR_API_URL=https://api.opentyphoon.ai/v1

# MongoDB Connection (Unified with flowdot database)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=flowdot

# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MAIN_MODEL=qwen2.5:3b
OLLAMA_WORKER_MODEL=qwen3:1.7b

# System Settings
DEBUG=False
# Internal bearer token - MUST match backend/.env AI_SERVICE_TOKEN (at least 32 characters)
AI_SERVICE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
MAX_UPLOAD_BYTES=10485760
DEBOUNCE_WAIT_SECONDS=3.0
FAST_PATH_LATENCY_THRESHOLD_MS=200.0
