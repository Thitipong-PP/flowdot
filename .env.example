# ==============================================================================
# FLOW — SME Finance Copilot (Single Configuration File Template)
# Copy this to .env:  cp .env.example .env
# ==============================================================================

PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGIN=*
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=180000

MONGODB_URI=mongodb://127.0.0.1:27017/flowdot
MONGO_DB_NAME=flowdot

AI_SERVICE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345678!
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=Customer12345678!

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MAIN_MODEL=qwen2.5:3b
OLLAMA_WORKER_MODEL=qwen3:1.7b

TYPHOON_API_KEY=
TYPHOON_OCR_API_URL=https://api.opentyphoon.ai/v1

NEXT_PUBLIC_API_URL=/api/v1
NODE_ENV=development
DEBUG=False
